# URL publik aplikasi (dipakai untuk link undangan dan rundown)
BETTER_AUTH_URL=http://localhost:3000
# Rahasia acak minimal 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter

# PostgreSQL. Kosongkan untuk memakai PGlite (Postgres embedded) di .data/pglite saat development.
DATABASE_URL=

# Google OAuth (opsional). Tombol Google muncul hanya bila keduanya diisi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (OTP, undangan, pengingat termin). Kosongkan untuk mencetak email ke log server.
SMTP_URL=
MAIL_FROM="Rukun <noreply@example.com>"

# Penyimpanan file MinIO / S3. Kosongkan untuk menyimpan di .data/uploads.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=rukun-private
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Redis untuk BullMQ (worker pengingat). Kosongkan untuk mode interval sederhana.
REDIS_URL=
# Melindungi endpoint /api/cron/reminders
CRON_SECRET=

# Hanya untuk docker-compose
DOMAIN=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Format: nama-kunci:base64-32-byte, contoh: rukun-key:$(openssl rand -base64 32)
MINIO_KMS_SECRET_KEY=
# Opsional: analytics Umami self-hosted
UMAMI_URL=
UMAMI_WEBSITE_ID=
